# Copie para .env na VM (chmod 600). Valores SEM aspas (o Docker env_file
# mantém aspas como parte do valor).
R2_ACCOUNT_ID=
R2_BUCKET_NAME=sondas
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Token só de leitura "Account Analytics: Read" (painel de métricas do R2).
CLOUDFLARE_API_TOKEN=
# Protege /api/poll. Gere: head -c 24 /dev/urandom | base64 | tr -dc A-Za-z0-9 | head -c 32
CRON_SECRET=
